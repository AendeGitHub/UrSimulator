{
  "name": "ursim",
  "version": "1.0.0",
  "private": true,
  "description": "UrSim — FTC BIOBUZZ driving simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "convert:field": "node --max-old-space-size=8192 tools/convert-field.mjs && npm run build:colliders",
    "build:colliders": "node tools/build-colliders.mjs",
    "server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-server/index.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev:lan": "vite --host",
    "start": "node dist-server/index.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "three": "0.170.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.1.1",
    "@gltf-transform/extensions": "4.1.1",
    "@gltf-transform/functions": "4.1.1",
    "@types/node": "22.9.0",
    "@types/three": "0.170.0",
    "@types/ws": "8.5.12",
    "esbuild": "0.24.0",
    "meshoptimizer": "0.22.0",
    "occt-import-js": "0.0.22",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
